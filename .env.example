# Copy this file to .env and fill in what you need. .env is gitignored.

# --- required for forward-testing -------------------------------------------
# Free tier: https://the-odds-api.com  (500 requests/month)
# Used by R/05_forward.R to fetch current game lines.
ODDS_API_KEY=

# --- optional: LLM strategy-signal extraction (R/09_llm_news.R) -------------
# Used ONLY for coach-revealed rotation and minutes intent, not for "who is
# out" -- the pattern rules in 06 handle that from ESPN's athlete tags. Every
# extraction is cached to data/llm_news_cache.jsonl and never re-queried, so
# cost scales with NEW articles only and the pipeline stays reproducible.
#
# Provider is CFG$llm$provider in R/config.R. Default is gemini.

# Google AI Studio -- free tier: 1,500 requests/day, 15/min, no card required.
# https://aistudio.google.com/apikey
# At ~50 articles/day that is 3% of the daily quota. Note free-tier content may
# be used by Google to improve their products; the input here is public ESPN
# news and no prediction of yours is ever sent.
GEMINI_API_KEY=

# Alternative provider. Billed separately from any Claude subscription -- a
# Pro/Max plan does NOT include API access, you buy Console credits.
ANTHROPIC_API_KEY=

# --- optional: structured injury designations (R/06_news_signals.R) --------
# https://sportsdata.io  -- free trial is 1,000 calls/month (~33/day).
# Sells probable/questionable/doubtful/out directly, which is better bought
# than extracted. NOTE: verify CFG$sportsdataio$injuries_path against your
# account's API explorer -- the path in config.R is a placeholder.
SPORTSDATAIO_API_KEY=
